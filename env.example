# 株価変動アラート — 環境変数で設定を渡す場合のサンプル
# 値を入れた行だけが有効になります（DB の設定より優先されます）。
# 使い方:  export $(grep -v '^#' .env | xargs)  などで読み込むか、
#          systemd / Docker の Environment に設定してください。

# ---- 監視動作 ----
STOCKALERT_POLL_INTERVAL=15
STOCKALERT_THRESHOLDS=15,20,25,30
STOCKALERT_RESPECT_MARKET_HOURS=true

# ---- ntfy（推奨） ----
STOCKALERT_NTFY_TOPIC=stock-alert-change-me-9x2f
STOCKALERT_NTFY_SERVER=https://ntfy.sh
# STOCKALERT_NTFY_TOKEN=

# ---- Telegram ----
# STOCKALERT_TELEGRAM_BOT_TOKEN=
# STOCKALERT_TELEGRAM_CHAT_ID=

# ---- Discord / Slack ----
# STOCKALERT_DISCORD_WEBHOOK_URL=
# STOCKALERT_SLACK_WEBHOOK_URL=

# ---- LINE Messaging API ----
# STOCKALERT_LINE_TOKEN=
# STOCKALERT_LINE_TO=

# ---- 汎用 Webhook ----
# STOCKALERT_GENERIC_WEBHOOK_URL=

# ---- メール ----
# STOCKALERT_SMTP_HOST=
# STOCKALERT_SMTP_PORT=587
# STOCKALERT_SMTP_USER=
# STOCKALERT_SMTP_PASSWORD=
# STOCKALERT_SMTP_FROM=
# STOCKALERT_SMTP_TO=

# ---- その他 ----
# STOCKALERT_SECRET_KEY=ランダムな文字列
# PORT=8000
# HOST=0.0.0.0
# STOCKALERT_ENABLE_SCHEDULER=true
# STOCKALERT_DATA_DIR=/app/data
